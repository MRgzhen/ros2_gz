<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="a3_ultra">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import a3_ultra urdf file -->
    <xacro:include filename="$(find robot_descriptions)/models/a3_ultra_t2d5/urdf/robot.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="a3_ultra.ros2_control.xacro" />


    <xacro:a3_ultra_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
